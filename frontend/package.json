{
  "name": "xingxie-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contracts:export": "uv run --project ../backend python scripts/export-backend-contracts.py",
    "contracts:verify": "node scripts/verify-contract-coverage.mjs",
    "dev": "vite",
    "generate:api": "node scripts/generate-api-types.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:visual": "playwright test tests/e2e/visual",
    "test:e2e": "playwright test",
    "build": "npm run contracts:verify && npm run typecheck && vite build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "electron": "43.1.1",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "playwright": "1.61.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
